---
import BaseLayout from '../layouts/BaseLayout.astro';
import skills from '../data/skills.json';
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Competências & Ferramentas — Kaíque Passaros" active="skills"><section class="page-hero compact"><p class="eyebrow">COMPETÊNCIAS &amp; FERRAMENTAS</p><h1>Competência demonstrada por aplicação.</h1><p class="lede">Em vez de níveis subjetivos, cada grupo evidencia onde a tecnologia entra e qual problema ajuda a resolver.</p></section><section class="section"><div class="section-head"><div><p class="eyebrow">COMPETÊNCIAS</p><h2>Capacidades aplicadas a problemas reais.</h2></div></div><div class="competency-grid">{skills.competencies.map((item,index)=><article class="competency-card"><span>{String(index+1).padStart(2,'0')}</span><h3>{item.name}</h3><p>{item.description}</p></article>)}</div></section><section class="section"><div class="section-head"><div><p class="eyebrow">TECNOLOGIAS &amp; PRÁTICAS</p><h2>Ferramentas organizadas por função.</h2></div></div><div class="technology-groups">{skills.technologyGroups.map(group=><section class="technology-group"><p class="eyebrow">{group.name}</p><div class="technology-cards">{group.items.map(item=>typeof item==='string'?<article>{item}</article>:<article class="technology-item described"><strong>{item.name}</strong><span>{item.purpose}</span></article>)}</div></section>)}</div></section><section class="section evidence"><div><p class="eyebrow">EVIDÊNCIA</p><h2>Skills conectadas aos cases.</h2></div><div><p>Os projetos detalham problema, papel, arquitetura, ferramentas e resultados. Assim, a stack deixa de ser uma lista e passa a ter contexto de aplicação.</p><a class="primary" href={`${base}projects/`}>Ver projetos</a></div></section></BaseLayout>
