---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
const projects=(await getCollection('projects',({data})=>data.publish)).filter(x=>x.data.featured);
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Início — Kaíque Passaros" active="inicio">
<section class="hero"><div class="hero-copy reading-surface"><p class="eyebrow">DADOS • BI • AUTOMAÇÃO</p><h1>Transformo dados em <em>decisões claras.</em></h1><p class="lede">Conecto contexto de negócio, processos e tecnologia para construir análises, produtos de dados e automações com aplicação real.</p><div class="actions"><a class="primary" href={`${base}projects/`}>Explorar projetos</a><a class="secondary" href={`${base}assets/files/curriculo-kaique-passaros.pdf`} target="_blank">Baixar currículo</a></div></div>
<div class="hero-visual"><div class="character-stage"><video id="hero-character" autoplay muted loop playsinline preload="auto" poster={`${base}assets/character/character-poster.jpg`}><source src={`${base}assets/character/character-loop.webm`} type="video/webm"/><source src={`${base}assets/character/character-loop.mp4`} type="video/mp4"/></video></div><aside class="signal"><span>POSICIONAMENTO</span><strong>Dados, BI e Transformação Digital</strong><p>Da investigação do problema à decisão orientada por evidências.</p><div class="signal-grid"><div><b>5+</b><small>anos em BI e dados</small></div><div><b>{projects.length}</b><small>projetos em destaque</small></div></div></aside></div></section>
<section class="home-paths section"><div class="section-head"><div><p class="eyebrow">NAVEGUE PELO PORTFÓLIO</p><h2>Vá direto ao assunto.</h2></div></div><div class="path-grid"><a class="path-card" href={`${base}about/`}><span>01</span><h3>Sobre mim</h3><p>Minha história, forma de pensar e o que me move.</p></a><a class="path-card" href={`${base}career/`}><span>02</span><h3>Carreira</h3><p>Da operação à transformação digital orientada por dados.</p></a><a class="path-card" href={`${base}skills/`}><span>03</span><h3>Competências</h3><p>Competências técnicas conectadas a aplicações reais.</p></a></div></section>
<section class="section building-public"><div><p class="eyebrow">BUILDING IN PUBLIC</p><h2>Evoluindo projetos de forma aberta.</h2><p>Este portfólio também é um produto: cases, documentação e melhorias ficam registrados no GitHub.</p></div><div class="public-metrics"><article><b>SSG</b><span>HTML estático</span></article><article><b>CI/CD</b><span>GitHub Actions</span></article><article><b>JSON</b><span>conteúdo estruturado</span></article></div></section>
<section class="section"><div class="section-head"><div><p class="eyebrow">PROJETOS EM DESTAQUE</p><h2>Cases construídos para resolver problemas reais.</h2></div><a class="text-link" href={`${base}projects/`}>Ver todos →</a></div><div class="project-grid">{projects.map(entry=><ProjectCard entry={entry} collection="projects"/>)}</div></section>
</BaseLayout>
