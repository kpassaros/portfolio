{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "status",
    "year",
    "summary",
    "problem",
    "role",
    "solution",
    "results",
    "technologies",
    "cover",
    "demo",
    "links"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "featured": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "demo": {
      "type": "object"
    }
  }
}